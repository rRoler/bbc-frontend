---
import PageLayout from '../../layouts/PageLayout.astro';
import SettingsPage from '../../components/views/SettingsPage.svelte';
import { settingsLocation } from '../../config/locations.ts';
---

<PageLayout title={settingsLocation.label} description={settingsLocation.description}>
	<div class="flex grow flex-col items-center p-4">
		<noscript>Please enable JavaScript to change settings</noscript>

		<SettingsPage client:load />
	</div>
</PageLayout>
