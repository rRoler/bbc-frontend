---
import PageLayout from '../../layouts/PageLayout.astro';
import Search from '../../components/views/SearchPage.svelte';
import { searchLocation } from '../../config/locations.ts';
---

<PageLayout
	title={searchLocation.label}
	description={searchLocation.description}
	disableSearch={true}
>
	<div class="flex grow flex-col items-center p-4">
		<noscript>Please enable JavaScript to search series</noscript>

		<Search client:load />
	</div>
</PageLayout>
