---
import BaseLayout from '../layouts/BaseLayout.astro';
import type PageProps from '../types/pageProps';
import { ArrowLeft } from 'lucide-svelte';
import ErrorAlert from '../components/ui/ErrorAlert.svelte';
import AppContent from '../components/layout/AppContent.svelte';
import GlobalSearchBox from '../components/domain/GlobalSearchBox.svelte';
import AppTitle from '../components/layout/AppTitle.astro';
import {
	aboutLocation,
	dockLocations,
	donationLocation,
	settingsLocation,
	sourceCodeLocation,
	statusLocation,
	discoveryLocation,
	homeLocation,
} from '../config/locations.ts';
import Tooltip from '../components/ui/Tooltip.svelte';
import { SITE_NAME } from '../utils/meta';

const props = Astro.props as PageProps & { disableSearch?: boolean; fixedNav?: boolean };
---

<BaseLayout {...props}>
	<ErrorAlert client:load />

	<div class="hidden size-full flex-col sm:flex">
		<div class="flex max-w-full grow flex-col overflow-x-hidden">
			<div
				class:list={[
					'navbar top-0 left-0 z-10 max-w-full overflow-hidden px-4',
					props.fixedNav ? 'fixed bg-transparent' : 'bg-base-200 sticky',
				]}
			>
				<div class="navbar-start gap-2">
					<Tooltip client:load position="bottom" tip="Go Back">
						<a id="nav-back" class="btn btn-ghost btn-circle" href="../">
							<ArrowLeft class="size-6" />
						</a>
					</Tooltip>
				</div>

				<div class="navbar-center gap-2">
					<a
						class={'btn-ghost btn' + (!props.disableSearch ? ' hidden sm:inline-flex' : '')}
						href={homeLocation.path}
						title={SITE_NAME}
					>
						<AppTitle />
					</a>
				</div>

				<div class="navbar-end gap-2">
					{!props.disableSearch && <GlobalSearchBox client:load size="lg" />}

					<Tooltip client:load position="bottom" tip={donationLocation.label}>
						<a
							href={donationLocation.path}
							target="_blank"
							class="btn btn-ghost btn-circle hidden xl:inline-flex"
						>
							<donationLocation.Icon class="fill-secondary text-secondary size-6" />
						</a>
					</Tooltip>

					<Tooltip client:load position="bottom" tip={sourceCodeLocation.label}>
						<a
							href={sourceCodeLocation.path}
							target="_blank"
							class="btn btn-ghost btn-circle hidden lg:inline-flex"
						>
							<sourceCodeLocation.Icon class="size-6" />
						</a>
					</Tooltip>

					<Tooltip client:load position="bottom" tip={statusLocation.label}>
						<a class="btn btn-ghost btn-circle hidden lg:inline-flex" href={statusLocation.path}>
							<statusLocation.Icon class="size-6" />
						</a>
					</Tooltip>

					<Tooltip client:load position="bottom" tip={discoveryLocation.label}>
						<a class="btn btn-ghost btn-circle" href={discoveryLocation.path}>
							<discoveryLocation.Icon class="size-6" />
						</a>
					</Tooltip>

					<Tooltip client:load position="bottom" tip={aboutLocation.label}>
						<a class="btn btn-ghost btn-circle" href={aboutLocation.path}>
							<aboutLocation.Icon class="size-6" />
						</a>
					</Tooltip>

					<Tooltip client:load position="bottom" tip={settingsLocation.label}>
						<a class="btn btn-ghost btn-circle" href={settingsLocation.path}>
							<settingsLocation.Icon class="size-6" />
						</a>
					</Tooltip>
				</div>
			</div>

			<AppContent id="desktop-app-content" isMobile={false} client:load>
				<slot />
			</AppContent>
		</div>
	</div>

	<div class="flex size-full flex-col sm:hidden">
		<AppContent id="mobile-app-content" isMobile={true} client:load>
			<slot />
		</AppContent>

		<div
			class:list={[
				'dock bottom-0 left-0 shrink-0',
				props.fixedNav ? 'fixed bg-transparent' : 'bg-base-200 sticky',
			]}
		>
			{
				dockLocations.map(({ path, Icon, label }) => {
					const isActive = Astro.url.pathname.startsWith(path);
					return (
						<a href={path} class={`dock-location ${isActive ? 'dock-active' : ''}`}>
							<Icon class="size-6" />
							<span class="dock-label">{label}</span>
						</a>
					);
				})
			}
		</div>
	</div>
</BaseLayout>

<script>
	import { dockLocations } from '../config/locations.ts';

	const navBack = document.querySelector<HTMLAnchorElement>('#nav-back');

	navBack?.addEventListener('click', (event) => {
		event.preventDefault();
		window.history.back();
	});

	// @ts-expect-error low browser compatibility
	if (window.navigation?.canGoBack === false) navBack?.classList.add('hidden');

	for (const page of dockLocations) {
		let dockElement = document.querySelector<HTMLAnchorElement>(
			`a.dock-location[href^="${page.path}"]`
		);

		if (page.storageKey) {
			const storedPage = localStorage.getItem(page.storageKey);
			if (storedPage && dockElement) dockElement.href = storedPage;
		}

		if (dockElement?.classList.contains('dock-active')) {
			dockElement.addEventListener('click', (e) => {
				if (!page.onclick) return;
				e.preventDefault();
				page.onclick();
			});

			page.onclick?.();
		}
	}
</script>

<script>
	import userState from '../stores/user.svelte.ts';
	userState.init();
</script>
